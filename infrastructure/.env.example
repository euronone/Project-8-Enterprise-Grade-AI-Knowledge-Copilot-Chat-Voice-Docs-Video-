# ============================================================
# infrastructure/.env.example
# Copy to infrastructure/.env and fill in your AWS credentials
# Source before running Terraform: source infrastructure/.env
# NEVER commit .env — it contains secrets
# ============================================================

# ── AWS Credentials ────────────────────────────────────────
# Create an IAM user with programmatic access in the AWS Console
# IAM → Users → Create User → Attach policies → AdministratorAccess
# Then create Access Keys under Security Credentials tab

export AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
export AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
export AWS_DEFAULT_REGION=us-east-1

# ── Optional: AWS Profile (alternative to keys above) ──────
# If you use `aws configure --profile knowledgeforge` instead:
# export AWS_PROFILE=knowledgeforge
